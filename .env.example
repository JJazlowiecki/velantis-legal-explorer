DATABASE_URL=postgresql://velantis_dev:velantis_dev_password@127.0.0.1:5432/velantis_legal_explorer
POSTGRES_DB=velantis_legal_explorer
POSTGRES_USER=velantis_dev
POSTGRES_PASSWORD=velantis_dev_password

# Separate, disposable database for DB-backed integration tests (pnpm test).
# Must never equal DATABASE_URL and must name a test-only database — this is
# enforced at test time. See docker/init-test-db.sh for local provisioning.
TEST_DATABASE_URL=postgresql://velantis_dev:velantis_dev_password@127.0.0.1:5432/velantis_legal_explorer_test

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ISSUE_DETECTION_MODEL=gpt-4o-mini
OPENAI_FINAL_ANSWER_MODEL=gpt-4o-mini
OPENAI_GROUNDING_VERIFICATION_MODEL=gpt-4o-mini
# Second, skeptical verification pass (src/lib/legal/answer/skeptic.ts) — hunts for
# unsupported legal leaps in conclusions that already passed strict verification.
OPENAI_GROUNDING_SKEPTIC_MODEL=gpt-4o-mini
# Bounded, source-first recovery generation pass (src/lib/legal/answer/recovery.ts) — runs at
# most once, only when the normal pipeline produced zero verified conclusions despite usable
# retrieval evidence.
OPENAI_GROUNDING_RECOVERY_MODEL=gpt-4o-mini

# Minimum cosine similarity for a vector-only search result to be kept (never applied
# to exact citation or lexical matches). Calibrated against text-embedding-3-small;
# see src/lib/env/schema.ts for the reasoning.
LEGAL_SEARCH_MIN_VECTOR_SIMILARITY=0.35

# Comma-separated legalActVersion UUID(s) used ONLY by the local /explorer technical test
# UI (feature/explorer-live-search milestone). This is a historical/promulgated test
# corpus (DU/1960/168, KPA) with unproven currentness — never a global current-law corpus.
EXPLORER_TEST_LEGAL_ACT_VERSION_IDS=

# Enables persisting /explorer search history (see src/lib/explorer/history/). Search
# queries may contain sensitive legal/personal information. Only the literal strings
# "true"/"false" are valid. Defaults to enabled (true) for local development — reconsider
# this default before any real deployment. When disabled, /explorer search still works
# normally; it simply never writes a history row, and /explorer/history shows an empty state.
EXPLORER_HISTORY_ENABLED=true

# Hard cap on the number of Saved items per visitor (src/lib/explorer/saved/). Folders do not
# count toward this. A global MVP default — see EXPLORER_SAVED_MAX_ITEMS usage in
# src/lib/explorer/saved/quota.ts for how a future plan/subscription layer can override it
# per-visitor without changing Saved persistence.
EXPLORER_SAVED_MAX_ITEMS=100

# History retention (src/lib/explorer/history/service.ts, cleanupHistoryForVisitor). Two
# independent limits, both enforced opportunistically right after a new history write:
# entries older than RETENTION_DAYS may be deleted, and each visitor keeps at most
# MAX_ENTRIES rows (oldest deleted first once exceeded). Saved items are a separate table
# and are never affected by this cleanup.
EXPLORER_HISTORY_RETENTION_DAYS=90
EXPLORER_HISTORY_MAX_ENTRIES=300

# Explorer runtime corpus mode — "test" (default) or "current". See EXPLORER_CURRENT_CORPUS_RUN_ID below.
EXPLORER_CORPUS_MODE=test
# Required only when EXPLORER_CORPUS_MODE=current — the pinned current_law_corpus_runs.id to serve from.
EXPLORER_CURRENT_CORPUS_RUN_ID=

# === Auth (Better Auth) — see src/lib/auth/auth.ts ===
# Required in production (a fixed insecure fallback is used automatically in local dev only).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin the app is served from — used for auth redirect/link validation and as the
# one trusted origin. Set to the real HTTPS domain in production.
APP_BASE_URL=http://localhost:3000

# === Transactional mail (password reset / email verification) — see src/lib/mail/send.ts ===
# Resend-compatible HTTP API. Both required for mail to actually send; either missing means
# "not configured" (safe no-op — auth flows still work, they just cannot deliver email).
MAIL_API_KEY=
MAIL_FROM=

# === Stripe (TEST MODE for this milestone) — see src/lib/billing/*, docs/PRODUCTION.md ===
# All four optional: FREE plan and the rest of the app work fully without them; paid plan
# buttons show a truthful "billing not configured" state instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=

# === Trust / legal shell — see src/lib/legal-shell/config.ts ===
# Plain informational placeholders shown on /terms, /privacy, /legal. Never invented if absent.
COMPANY_NAME=
CONTACT_EMAIL=
