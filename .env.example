DATABASE_URL=postgresql://velantis_dev:velantis_dev_password@127.0.0.1:5432/velantis_legal_explorer
POSTGRES_DB=velantis_legal_explorer
POSTGRES_USER=velantis_dev
POSTGRES_PASSWORD=velantis_dev_password

# Separate, disposable database for DB-backed integration tests (pnpm test).
# Must never equal DATABASE_URL and must name a test-only database — this is
# enforced at test time. See docker/init-test-db.sh for local provisioning.
TEST_DATABASE_URL=postgresql://velantis_dev:velantis_dev_password@127.0.0.1:5432/velantis_legal_explorer_test

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ISSUE_DETECTION_MODEL=gpt-4o-mini
OPENAI_FINAL_ANSWER_MODEL=gpt-4o-mini
OPENAI_GROUNDING_VERIFICATION_MODEL=gpt-4o-mini
# Second, skeptical verification pass (src/lib/legal/answer/skeptic.ts) — hunts for
# unsupported legal leaps in conclusions that already passed strict verification.
OPENAI_GROUNDING_SKEPTIC_MODEL=gpt-4o-mini
# Bounded, source-first recovery generation pass (src/lib/legal/answer/recovery.ts) — runs at
# most once, only when the normal pipeline produced zero verified conclusions despite usable
# retrieval evidence.
OPENAI_GROUNDING_RECOVERY_MODEL=gpt-4o-mini

# Minimum cosine similarity for a vector-only search result to be kept (never applied
# to exact citation or lexical matches). Calibrated against text-embedding-3-small;
# see src/lib/env/schema.ts for the reasoning.
LEGAL_SEARCH_MIN_VECTOR_SIMILARITY=0.35

# Comma-separated legalActVersion UUID(s) used ONLY by the local /explorer technical test
# UI (feature/explorer-live-search milestone). This is a historical/promulgated test
# corpus (DU/1960/168, KPA) with unproven currentness — never a global current-law corpus.
EXPLORER_TEST_LEGAL_ACT_VERSION_IDS=

# Enables persisting /explorer search history (see src/lib/explorer/history/). Search
# queries may contain sensitive legal/personal information. Only the literal strings
# "true"/"false" are valid. Defaults to enabled (true) for local development — reconsider
# this default before any real deployment. When disabled, /explorer search still works
# normally; it simply never writes a history row, and /explorer/history shows an empty state.
EXPLORER_HISTORY_ENABLED=true
